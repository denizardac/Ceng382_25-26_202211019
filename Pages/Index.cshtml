@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Week 5 - Class Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MyRazorApp</title>
    <!-- Bootstrap CSS -->
    <link
        rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
    />

    <style>
        /* İsteğe bağlı hafif gradient arka plan */
        body {
            background: linear-gradient(120deg, #d9ecf2, #f2ffff);
        }
        /* Card başlık rengi (teal benzeri) */
        .bg-teal {
            background-color: #20c997;
        }
        /* Yükseklik ayarı, footer'ı alta itmek için */
        html, body {
            height: 100%;
        }
        .min-vh-100 {
            min-height: 100vh;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navbar (statik, hiçbir JS olmadan basit görüntü) -->
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand mb-0 h1">MyRazorApp</span>
            <div>
                <a class="text-white mr-3" href="Index">Home</a>
                <a class="text-white" href="#">Privacy</a>
            </div>
        </div>
    </nav>

    <!-- Ana içerik -->
    <main class="container my-4 flex-grow-1">
        <div class="row">
            <!-- SOL: Form -->
            <div class="col-md-6 mb-4">
                <div class="card shadow border-0 rounded">
                    <div class="card-header bg-teal text-white">
                        <h4 class="mb-0">Add / Edit Class</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <label asp-for="NewClass.ClassName" class="font-weight-bold"></label>
                                <input
                                    asp-for="NewClass.ClassName"
                                    class="form-control"
                                    placeholder="Enter class name" />
                                <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NewClass.StudentCount" class="font-weight-bold"></label>
                                <input
                                    asp-for="NewClass.StudentCount"
                                    class="form-control"
                                    placeholder="Enter student count" />
                                <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NewClass.Description" class="font-weight-bold"></label>
                                <textarea
                                    asp-for="NewClass.Description"
                                    class="form-control"
                                    placeholder="Enter description"></textarea>
                                <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                            </div>

                            <button type="submit" asp-page-handler="Add" class="btn btn-success w-100">
                                Add / Update
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- SAĞ: Tablo -->
            <div class="col-md-6 mb-4">
                <div class="card shadow border-0 rounded">
                    <div class="card-header bg-dark text-white">
                        <h4 class="mb-0">Class List</h4>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="thead-dark">
                                <tr>
                                    <th style="width: 50px;">Id</th>
                                    <th>Class Name</th>
                                    <th>Student Count</th>
                                    <th>Description</th>
                                    <th style="width: 150px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Classes)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@item.ClassName</td>
                                        <td>@item.StudentCount</td>
                                        <td>@item.Description</td>
                                        <td>
                                            <!-- Delete -->
                                            <form method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button
                                                    type="submit"
                                                    asp-page-handler="Delete"
                                                    class="btn btn-danger btn-sm"
                                                >
                                                    Delete
                                                </button>
                                            </form>
                                            <!-- Edit -->
                                            <form method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button
                                                    type="submit"
                                                    asp-page-handler="Edit"
                                                    class="btn btn-secondary btn-sm"
                                                >
                                                    Edit
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer (no JS, sabit değil ama sayfa içeriğine göre alta iner) -->
    <footer class="bg-dark text-white py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; 2025 - MyRazorApp | All rights reserved.</small>
        </div>
    </footer>

    <!-- No JavaScript: Partial Validation Scripts KALDIRILDI.
         Yani tamamen server-side validation kullanıyoruz.
         Kaldırmak için bu satırı da yok ediyoruz: -->
    @* <partial name="_ValidationScriptsPartial" /> *@
</body>
</html>
