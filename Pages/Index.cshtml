@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management - Week 6";
}

<h2>Class List with Filtering & Pagination</h2>

<!-- Filtre Formu (GET) -->
<form method="get" asp-page="/Index">
    <div class="form-group">
        <label for="Filter">Filter by Class Name:</label>
        <input type="text" id="Filter" name="Filter" value="@Model.Filter" class="form-control" placeholder="Enter class name" />
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
</form>

<!-- Tablo: Filtrelenmiş ve Sayfalanmış veriler -->
<table class="table table-striped">
    <thead>
        <tr>
            <!-- ID tabloda gösterilmiyor -->
            <th>Class Name</th>
            <th>Student Count</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.FilteredClasses)
    {
        <tr>
            <td>@item.ClassName</td>
            <td>@item.StudentCount</td>
            <td>@item.Description</td>
            <td>
                <!-- Edit -->
                <form method="post" asp-page="/Index" asp-page-handler="Edit" style="display:inline;">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-warning">Edit</button>
                </form>
                <!-- Delete -->
                <form method="post" asp-page="/Index" asp-page-handler="Delete" style="display:inline; margin-left:5px;">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<!-- Sayfalama Kontrolleri -->
@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <!-- Previous -->
            @if (Model.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" 
                       asp-page="/Index"
                       asp-route-Page="@(Model.Page - 1)"
                       asp-route-Filter="@Model.Filter">
                       Previous
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                </li>
            }

            <!-- Sayfa Numaraları -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.Page)
                {
                    <li class="page-item active">
                        <span class="page-link">@i</span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/Index"
                           asp-route-Page="@i"
                           asp-route-Filter="@Model.Filter">
                           @i
                        </a>
                    </li>
                }
            }

            <!-- Next -->
            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="/Index"
                       asp-route-Page="@(Model.Page + 1)"
                       asp-route-Filter="@Model.Filter">
                       Next
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Next</span>
                </li>
            }
        </ul>
    </nav>
}

<!-- Add / Edit Formu -->
<h3>@(Model.NewClass.Id == 0 ? "Add New Class" : "Edit Class")</h3>
<form method="post" asp-page="/Index" asp-page-handler="Add">
    <div class="form-group">
        <label asp-for="NewClass.ClassName"></label>
        <input asp-for="NewClass.ClassName" class="form-control" />
        <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="NewClass.StudentCount"></label>
        <input asp-for="NewClass.StudentCount" class="form-control" />
        <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="NewClass.Description"></label>
        <textarea asp-for="NewClass.Description" class="form-control"></textarea>
        <span asp-validation-for="NewClass.Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">@((Model.NewClass.Id == 0) ? "Add" : "Update")</button>
</form>
